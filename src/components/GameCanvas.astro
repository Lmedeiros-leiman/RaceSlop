---
// Client-only bridge. The game module only runs in the browser via
// the module script below, never during Astro SSR / static prerender.
---
<div style="position: relative;">
  <canvas
    id="raceslop-canvas"
    width="960"
    height="540"
    style="width: 100%; height: auto; display: block; background: #111;"
  ></canvas>
  <div
    id="raceslop-hud"
    style="position: absolute; top: 8px; left: 8px; color: #fff; font-family: monospace; font-size: 14px; text-shadow: 1px 1px 2px #000;"
  ></div>
  <div
    id="raceslop-overlay"
    style="position: absolute; inset: 0; display: flex; pointer-events: none;"
  ></div>
  <canvas
    id="raceslop-minimap"
    width="140"
    height="140"
    style="position: absolute; top: 8px; right: 8px; background: rgba(8,8,12,0.65); border-radius: 8px;"
  ></canvas>
</div>

<script>
  import { initGame } from '../game/main.ts';

  const canvas = document.getElementById('raceslop-canvas');
  const hud = document.getElementById('raceslop-hud');
  const overlay = document.getElementById('raceslop-overlay');
  const minimap = document.getElementById('raceslop-minimap');
  if (canvas instanceof HTMLCanvasElement && hud instanceof HTMLElement && overlay instanceof HTMLElement && minimap instanceof HTMLCanvasElement) {
    initGame(canvas, hud, overlay, minimap);
  }
</script>

---
const base = import.meta.env.BASE_URL;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RaceSlop — singleplayer kart racer</title>
  </head>
  <body style="font-family: system-ui, sans-serif; max-width: 640px; margin: 4rem auto; padding: 0 1rem;">
    <h1>RaceSlop</h1>
    <p>A singleplayer 3D kart racer for the web. Time-trial first.</p>
    <p><a href={`${base}play/`}>Play the prototype</a></p>
    <ul>
      <li>M1: 1 kart + 1 track, drift + boost, best-lap timer</li>
      <li>M2: 4 characters + 4 tracks</li>
    </ul>
  </body>
</html>

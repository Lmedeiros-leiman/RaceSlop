---
import GameCanvas from '../components/GameCanvas.astro';

const base = import.meta.env.BASE_URL;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RaceSlop — prototype</title>
  </head>
  <body style="font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem;">
    <p><a href={`${base}`}>← Back</a></p>
    <h1>Prototype track</h1>
    <GameCanvas />
    <p>
      ←/→ select · Enter confirm · Esc back — drive: WASD/arrows, Space/Shift drift, R reset, Enter restart.
    </p>
  </body>
</html>
